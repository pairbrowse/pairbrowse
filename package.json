{
  "name": "pairbrowse",
  "version": "0.16.5",
  "private": true,
  "type": "module",
  "description": "Pair-browse with Claude Code in a visible PairBrowse browser window.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/integration/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:live": "node --test test/integration/*.test.mjs",
    "test:optin": "node --test test/optin/*.test.mjs",
    "test:fuzz": "node --test test/fuzz/*.test.js",
    "bench:check": "PAIRBROWSE_TEST_RUNTIME=${PAIRBROWSE_TEST_RUNTIME:-$HOME/.pairbrowse/runtime} node test/bench.mjs --check test/bench-budgets.json",
    "lint": "eslint --max-warnings 0 .",
    "coverage": "c8 node --test test/*.test.mjs test/integration/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.13.0",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0"
  }
}
