{
  "manifest_version": 3,
  "name": "PairBrowse",
  "version": "1.5",
  "description": "The PairBrowse side panel and new tab page: what Claude is doing, your turn, activity, and your remembered details and passwords.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "PairBrowse",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the PairBrowse side panel"
    }
  }
}
